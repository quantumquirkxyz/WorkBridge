# Puente Laboral Panamá — apps/web environment
#
# Copy to `.env.local` and fill in as needed. With no API key the intake API
# uses the deterministic heuristic extractor and still returns a schema-valid
# CandidateProfile, so these are optional for local development.

# OpenRouter API key. When set, the Profile agent uses an LLM extractor wrapped
# in a resilient fallback to the heuristic extractor.
OPENROUTER_API_KEY=

# Text model used to extract the profile draft.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional vision model. When set, images are described by the model; otherwise
# provide `altText` in the intake request for image sources.
OPENROUTER_VISION_MODEL=

# Optional OpenRouter-compatible base URL override.
OPENROUTER_BASE_URL=
