# WorkBridge — apps/web environment
#
# Copy to `.env.local` and fill in as needed. Next.js does not read the
# monorepo-root .env. With no API key the intake API uses the deterministic
# heuristic extractor and still returns a schema-valid CandidateProfile.

# Application runtime (npm start, default port 3000). Required for /postulaciones.
AGENT_RUNTIME_URL=http://localhost:3000

# Same secret and URL as the repo-root .env. The BFF signs the session with this secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Primary Postgres. neon-env can inject this when the dev server is started with it.
DATABASE_URL=

# OpenRouter API key. When set, the Profile agent uses an LLM extractor wrapped
# in a resilient fallback to the heuristic extractor.
OPENROUTER_API_KEY=

# Text model used to extract the profile draft.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional vision model. When set, images are described by the model; otherwise
# provide `altText` in the intake request for image sources.
OPENROUTER_VISION_MODEL=

# Optional OpenRouter-compatible base URL override.
OPENROUTER_BASE_URL=

# Optional. Used by matching when a route or geocode is requested.
GOOGLE_MAPS_API_KEY=
