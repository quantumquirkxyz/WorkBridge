{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://puente-laboral.pa/schemas/experience/1.0.0","title":"CandidateExperience","description":"A formal or informal experience entry with a deterministic relevance classification and evidence provenance.","type":"object","additionalProperties":false,"required":["id","experience_type","title","description","source","relevance","relevance_reason","skill_ids","evidence_ids","confidence"],"properties":{"id":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/identifier"},"experience_type":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/experience_type"},"title":{"type":"string","minLength":1,"maxLength":200},"organization":{"type":"string","maxLength":200},"description":{"type":"string","maxLength":4000},"started_at":{"type":"string","format":"date"},"ended_at":{"type":"string","format":"date"},"ongoing":{"type":"boolean"},"location":{"type":"string","maxLength":200},"source":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/provenance"},"relevance":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/relevance"},"relevance_reason":{"type":"string","minLength":1,"maxLength":1000},"skill_ids":{"type":"array","items":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/identifier"},"uniqueItems":true},"evidence_ids":{"type":"array","items":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/identifier"},"uniqueItems":true},"confidence":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/confidence"}},"allOf":[{"description":"An entry without description or evidence cannot be classified as relevant.","if":{"properties":{"relevance":{"enum":["relevant","partially_relevant"]}},"required":["relevance"]},"then":{"properties":{"description":{"type":"string","minLength":1},"evidence_ids":{"type":"array","minItems":1}}}}]}