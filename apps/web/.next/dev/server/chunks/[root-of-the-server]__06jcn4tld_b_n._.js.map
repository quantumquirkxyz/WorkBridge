{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://puente-laboral.pa/schemas/skill/1.0.0","title":"CandidateSkill","description":"A candidate skill with canonical identity, level 0-4, provenance, supporting evidence and confidence. A declared-only skill cannot exceed level 1, and a skill above level 0 must carry at least one piece of evidence.","type":"object","additionalProperties":false,"required":["skill_id","canonical_name","original_term","kind","level","evidence_ids","source","confidence"],"properties":{"skill_id":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/identifier"},"canonical_name":{"type":"string","minLength":1,"maxLength":200},"original_term":{"type":"string","minLength":1,"maxLength":200,"description":"The candidate's own wording, always preserved."},"kind":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/skill_kind"},"level":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/skill_level"},"evidence_ids":{"type":"array","items":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/identifier"},"uniqueItems":true},"source":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/provenance"},"confidence":{"$ref":"https://puente-laboral.pa/schemas/common/1.0.0#/$defs/confidence"},"synonyms":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"esco_reference":{"type":"string","maxLength":300},"normalization_notes":{"type":"array","items":{"type":"string","minLength":1}}},"allOf":[{"description":"A declared-only skill stays at level 1 or below.","if":{"properties":{"source":{"const":"declared"}},"required":["source"]},"then":{"properties":{"level":{"type":"integer","maximum":1}}}},{"description":"Any skill above level 0 must cite at least one evidence item.","if":{"properties":{"level":{"type":"integer","minimum":1}},"required":["level"]},"then":{"properties":{"evidence_ids":{"type":"array","minItems":1}}}}]}