# Server-side only. Never expose these values to the browser.
# Local Certo accepts http only for localhost and 127.0.0.1. Any other host must be https.
CERTO_BASE_URL=
CERTO_API_TOKEN=
ACCREDIBLE_API_TOKEN=
# Credly's documented assertion URL does not use this token.
CREDLY_API_TOKEN=
# Deterministic matching: Google Maps Distance Matrix plus Google Geocoding.
# When unset, the runtime uses the solver's local matrix and the offline Panama
# geocoding catalog instead. Never expose this value to the browser.
GOOGLE_MAPS_API_KEY=
