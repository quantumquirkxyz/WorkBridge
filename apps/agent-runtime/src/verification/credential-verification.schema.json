{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puente-laboral.local/schemas/credential-verification.json",
  "title": "CredentialVerification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "document_integrity",
    "cryptographic_proof",
    "issuer_trust",
    "revocation_status",
    "holder_binding",
    "provider",
    "externally_verified",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["verified", "declared", "unverified", "rejected"]
    },
    "document_integrity": { "type": ["boolean", "null"] },
    "cryptographic_proof": { "type": ["boolean", "null"] },
    "issuer_trust": { "type": ["boolean", "null"] },
    "revocation_status": {
      "type": "string",
      "enum": ["not_revoked", "revoked", "unknown"]
    },
    "holder_binding": {
      "type": "string",
      "enum": ["bound", "unbound", "unknown"]
    },
    "provider": {
      "type": "string",
      "enum": ["certo", "accredible", "credly", "mock"]
    },
    "externally_verified": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "result"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "result": {
            "type": "string",
            "enum": ["success", "error", "warning", "skipped"]
          },
          "message": { "type": "string" }
        }
      }
    },
    "fallback_reason": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provider": { "const": "mock" } },
        "required": ["provider"]
      },
      "then": {
        "properties": { "externally_verified": { "const": false } }
      }
    },
    {
      "if": {
        "properties": { "provider": { "enum": ["certo", "accredible", "credly"] } },
        "required": ["provider"]
      },
      "then": {
        "properties": { "externally_verified": { "const": true } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "verified" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "document_integrity": { "const": true },
          "cryptographic_proof": { "const": true },
          "issuer_trust": { "const": true },
          "revocation_status": { "const": "not_revoked" },
          "holder_binding": { "const": "bound" }
        }
      }
    }
  ]
}
