{
  "name": "puente-laboral-panama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Puente Laboral Panamá — multi-agent employability system for young people in Panama.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "tsx apps/agent-runtime/src/application/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^5.0.5"
  }
}
