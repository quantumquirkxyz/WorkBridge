{
  "name": "puente-laboral-panama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Puente Laboral Panamá — multi-agent employability system for young people in Panama.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "tsx apps/agent-runtime/src/application/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @puente/web",
    "gate:ci": "npm run typecheck && npm run test:coverage",
    "db:migrate": "NODE_OPTIONS=--no-network-family-autoselection neon psql production -- -f migrations/001_initial.sql",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "pg": "^8.23.1"
  }
}
