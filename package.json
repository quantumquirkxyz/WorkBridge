{
  "name": "workbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkBridge — multi-agent employability system for young people in Panama.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env --import tsx apps/agent-runtime/src/application/main.ts",
    "certo:up": "node scripts/certo.mjs up",
    "certo:down": "node scripts/certo.mjs down",
    "local:up": "docker compose up --build -d",
    "local:down": "docker compose down",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @workbridge/web",
    "gate:ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "db:migrate": "NODE_OPTIONS=--no-network-family-autoselection neon psql production -- -f migrations/001_initial.sql -f migrations/002_better_auth.sql -f migrations/003_chat_sessions.sql -f migrations/004_chat_jobs.sql",
    "seed:roles": "tsx scripts/seed-roles.ts",
    "seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "start:worker": "node --env-file=.env --import tsx apps/web/scripts/chat-worker.ts",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.11.1",
    "eslint": "^9.17.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "pg": "^8.23.1"
  }
}
