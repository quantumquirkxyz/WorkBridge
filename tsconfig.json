{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/web/*"
      ],
      "@workbridge/domain": [
        "packages/domain/src/index.ts"
      ],
      "@workbridge/solver": [
        "packages/solver/src/index.ts"
      ],
      "@workbridge/ingestion": [
        "packages/ingestion/src/index.ts"
      ],
      "@workbridge/profile": [
        "packages/profile/src/index.ts"
      ],
      "@workbridge/catalog": [
        "packages/catalog/src/index.ts"
      ],
      "@workbridge/training": [
        "packages/training/src/index.ts"
      ],
      "@workbridge/agent-runtime": [
        "apps/agent-runtime/src/index.ts"
      ]
    },
    "moduleDetection": "force",
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ]
}
