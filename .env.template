# Quirk Skills Environment Variables

# Skill Bundle Path
SKILLS_DIR=.agents/skills

# Sandbox Directory
SANDBOX_DIR=.skill-sandbox

# Skill Lab Execution Policy
SKILL_LAB_POLICY=strict

# Metrics Directory
METRICS_DIR=.agents/skills/platform/runs

# Registry
SKILL_REGISTRY_ENABLED=true

# Validation Mode
VALIDATION_MODE=full

# Playground Settings
PLAYGROUND_DIR=system-temp

# CI/CD Integration
CI_ENABLED=true

# Multi-Agent Protocol
MULTI_AGENT_ENABLED=true

# Skill Quality Audit
AUDIT_ENABLED=true

# Skill Evolution
EVOLUTION_ENABLED=true
