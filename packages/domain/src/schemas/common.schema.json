{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puente-laboral.pa/schemas/common/1.0.0",
  "title": "Common definitions",
  "description": "Shared enums and scalar definitions for the Puente Laboral Panamá agent contracts. Version 1.0.0, JSON Schema 2020-12.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "description": "How a fact entered the system: declared by the candidate, extracted from a document, verified against an external source, or inferred by a model.",
      "type": "string",
      "enum": ["declared", "extracted", "verified", "inferred"]
    },
    "skill_kind": {
      "type": "string",
      "enum": ["technical", "soft"]
    },
    "skill_level": {
      "description": "Ordinal skill level: 0 no evidence, 1 basic, 2 functional, 3 advanced, 4 expert.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "experience_type": {
      "type": "string",
      "enum": [
        "formal_employment",
        "informal_work",
        "family_business",
        "volunteering",
        "project",
        "academic",
        "internship"
      ]
    },
    "relevance": {
      "type": "string",
      "enum": [
        "relevant",
        "partially_relevant",
        "not_relevant",
        "requires_additional_evidence"
      ]
    },
    "credential_status": {
      "description": "Normalized credential verification state. Only `verified` satisfies a mandatory credential.",
      "type": "string",
      "enum": ["declared", "verified", "partially_verified", "unverified", "rejected"]
    },
    "intake_source_kind": {
      "type": "string",
      "enum": ["pdf", "image", "text", "audio_transcript"]
    },
    "language_tag": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "BCP-47 style tag, e.g. `es-PA`."
    }
  }
}
