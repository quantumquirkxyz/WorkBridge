{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbridge.pa/schemas/common/1.0.0",
  "title": "Common definitions",
  "description": "Shared enums and scalar definitions for the WorkBridge agent contracts. Version 1.0.0, JSON Schema 2020-12.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "description": "How a fact entered the system: declared by the candidate, extracted from a document, verified against an external source, or inferred by a model.",
      "type": "string",
      "enum": ["declared", "extracted", "verified", "inferred"]
    },
    "skill_kind": {
      "type": "string",
      "enum": ["technical", "soft"]
    },
    "skill_level": {
      "description": "Ordinal skill level: 0 no evidence, 1 basic, 2 functional, 3 advanced, 4 expert.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "experience_type": {
      "type": "string",
      "enum": [
        "formal_employment",
        "informal_work",
        "family_business",
        "volunteering",
        "project",
        "academic",
        "internship"
      ]
    },
    "relevance": {
      "type": "string",
      "enum": [
        "relevant",
        "partially_relevant",
        "not_relevant",
        "requires_additional_evidence"
      ]
    },
    "credential_status": {
      "description": "Normalized credential verification state. Only `verified` satisfies a mandatory credential.",
      "type": "string",
      "enum": ["declared", "verified", "partially_verified", "unverified", "rejected"]
    },
    "intake_source_kind": {
      "type": "string",
      "enum": ["pdf", "image", "text", "audio_transcript"]
    },
    "language_tag": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "BCP-47 style tag, e.g. `es-PA`."
    },
    "work_modality": {
      "description": "Where the work is performed: on-site, hybrid, or fully remote.",
      "type": "string",
      "enum": ["onsite", "hybrid", "remote"]
    },
    "transport_mode": {
      "description": "A way of commuting to work.",
      "type": "string",
      "enum": ["driving", "transit", "walking", "cycling"]
    },
    "geo_point": {
      "description": "Latitude and longitude used by geographic matching and routing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "contract_type": {
      "description": "Normalized employment contract type.",
      "type": "string",
      "enum": ["full_time", "part_time", "fixed_term", "internship", "temporary", "freelance"]
    },
    "location": {
      "description": "A Panamanian location reference. Used both for a candidate's maximum acceptable area and for a vacancy's location.",
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "province", "district", "raw"],
      "properties": {
        "country": { "type": "string", "minLength": 2 },
        "province": { "type": ["string", "null"] },
        "district": { "type": ["string", "null"] },
        "raw": { "type": ["string", "null"] }
      }
    }
  }
}
