{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbridge.pa/schemas/workflow-run.schema.json",
  "title": "WorkflowRunRequest",
  "description": "REST body for the internal workflow run. Candidate text and declared credential claims are ports; they are not the CandidateProfile or CredentialVerification documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "idempotency_key",
    "candidateText",
    "vacancyText",
    "declaredCredentials",
    "actor",
    "requestedTools"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "candidateText": { "type": "string", "minLength": 1 },
    "vacancyText": { "type": "string", "minLength": 1 },
    "declaredCredentials": {
      "type": "array",
      "items": { "$ref": "#/$defs/DeclaredCredentialClaim" }
    },
    "actor": { "$ref": "#/$defs/Actor" },
    "requestedTools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "preferences": { "$ref": "https://workbridge.pa/schemas/candidate-preferences/1.0.0" },
    "matchingInput": {
      "type": "object"
    }
  },
  "$defs": {
    "DeclaredCredentialClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["candidate", "counselor", "employer", "system"] }
      }
    }
  }
}
