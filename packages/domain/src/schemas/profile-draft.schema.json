{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbridge.pa/schemas/profile-draft/1.0.0",
  "title": "ProfileDraft",
  "description": "Un-normalized extraction produced by the Profile Agent (heuristic or LLM). Every upstream rule is re-applied deterministically during normalization, so this contract is deliberately permissive about levels and relevance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "full_name": { "type": "string", "maxLength": 200 },
    "locale": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/language_tag" },
    "target_roles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/draft_skill" } },
    "experiences": { "type": "array", "items": { "$ref": "#/$defs/draft_experience" } },
    "education": { "type": "array", "items": { "$ref": "#/$defs/draft_education" } },
    "certifications": { "type": "array", "items": { "$ref": "#/$defs/draft_certification" } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "draft_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source"],
      "properties": {
        "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "source": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/provenance" },
        "source_ref": { "type": "string", "maxLength": 500 },
        "excerpt": { "type": "string", "maxLength": 2000 },
        "confidence": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/confidence" }
      }
    },
    "draft_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_term"],
      "properties": {
        "original_term": { "type": "string", "minLength": 1, "maxLength": 200 },
        "canonical_hint": { "type": "string", "maxLength": 200 },
        "kind_hint": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/skill_kind" },
        "level_hint": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/skill_level" },
        "confidence": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/draft_evidence" } }
      }
    },
    "draft_experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_type", "title", "description"],
      "properties": {
        "experience_type": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/experience_type" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "organization": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "started_at": { "type": "string", "format": "date" },
        "ended_at": { "type": "string", "format": "date" },
        "ongoing": { "type": "boolean" },
        "location": { "type": "string", "maxLength": 200 },
        "confidence": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/draft_evidence" } }
      }
    },
    "draft_education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution", "program"],
      "properties": {
        "institution": { "type": "string", "minLength": 1, "maxLength": 200 },
        "program": { "type": "string", "minLength": 1, "maxLength": 200 },
        "level": {
          "type": "string",
          "enum": ["primary", "secondary", "technical", "undergraduate", "postgraduate", "course", "other"]
        },
        "started_at": { "type": "string", "format": "date" },
        "ended_at": { "type": "string", "format": "date" },
        "ongoing": { "type": "boolean" },
        "confidence": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/draft_evidence" } }
      }
    },
    "draft_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "issuer": { "type": "string", "maxLength": 200 },
        "issued_at": { "type": "string", "format": "date" },
        "expires_at": { "type": "string", "format": "date" },
        "credential_url": { "type": "string", "format": "uri" },
        "confidence": { "$ref": "https://workbridge.pa/schemas/common/1.0.0#/$defs/confidence" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/draft_evidence" } }
      }
    }
  }
}
