# Application runtime. Leave values empty in git. Never commit real tokens.
PORT=3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CERTO_BASE_URL=
CERTO_API_TOKEN=
OPENROUTER_API_KEY=
GOOGLE_MAPS_API_KEY=
ACCREDIBLE_API_KEY=
AUTH_SEED_ENV=development
SEED_COUNSELOR_EMAIL=counselor+development@example.test
SEED_EMPLOYER_EMAIL=employer+development@example.test
# Primary Postgres. When this is empty, NEON_DATABASE_URL is the backup target.
DATABASE_URL=
NEON_DATABASE_URL=
# Langfuse ingestion. When both keys are set, a completed workflow run POSTs one
# batch to LANGFUSE_BASE_URL/api/public/ingestion. An empty base URL uses
# https://cloud.langfuse.com. When either key is empty, the run makes no network
# call. A Langfuse failure does not fail the run. Never commit real keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
