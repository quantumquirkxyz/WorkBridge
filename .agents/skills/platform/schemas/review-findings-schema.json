{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewFindingsArtifact",
  "description": "Durable review findings artifact emitted by the review-pr skill.",
  "type": "object",
  "required": ["schemaVersion", "artifactType", "id", "skill", "skillVersion", "promptVersion", "createdAt", "updatedAt", "input", "output", "provenance", "evaluation"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "artifactType": { "type": "string", "const": "review" },
    "id": { "type": "string", "pattern": "^review-.+$" },
    "skill": { "type": "string", "const": "review-pr" },
    "skillVersion": { "type": "string" },
    "promptVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "required": ["fixedPoint", "diffCommand"],
      "properties": {
        "fixedPoint": { "type": "string" },
        "diffCommand": { "type": "string" },
        "commits": { "type": "array", "items": { "type": "string" } },
        "specSource": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "required": ["standardsFindings", "specFindings"],
      "properties": {
        "standardsFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "rule", "location", "description"],
            "properties": {
              "severity": { "type": "string", "enum": ["info", "warning", "high", "critical"] },
              "rule": { "type": "string" },
              "location": { "type": "string" },
              "description": { "type": "string" },
              "suggestedFix": { "type": "string" }
            }
          }
        },
        "specFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "requirement", "location", "description"],
            "properties": {
              "severity": { "type": "string", "enum": ["info", "warning", "high", "critical"] },
              "requirement": { "type": "string" },
              "location": { "type": "string" },
              "description": { "type": "string" },
              "suggestedFix": { "type": "string" }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["totalFindings", "standardsCount", "specCount", "worstStandard", "worstSpec"],
          "properties": {
            "totalFindings": { "type": "integer" },
            "standardsCount": { "type": "integer" },
            "specCount": { "type": "integer" },
            "worstStandard": { "type": "string" },
            "worstSpec": { "type": "string" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceOfTruth", "scope", "outOfScope", "nextConsumer"],
      "properties": {
        "sourceOfTruth": { "type": "string" },
        "scope": { "type": "string" },
        "outOfScope": { "type": "array", "items": { "type": "string" } },
        "nextConsumer": { "type": "string", "enum": ["plan-review-fixes", "ship-subissue", "resolving-merge-conflicts"] },
        "blockedBy": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "string" },
        "riskRemaining": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["qualityBarScore", "artifactPassedQualityBar", "evaluators"],
      "properties": {
        "qualityBarScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "artifactPassedQualityBar": { "type": "boolean" },
        "evaluators": {
          "type": "object",
          "required": ["behavioral", "regression", "review-effectiveness"],
          "properties": {
            "behavioral": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } },
            "regression": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } },
            "review-effectiveness": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } }
          }
        }
      }
    }
  }
}
