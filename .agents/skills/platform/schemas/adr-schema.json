{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdrArtifact",
  "description": "Durable ADR artifact emitted by the docs-adrs skill.",
  "type": "object",
  "required": ["schemaVersion", "artifactType", "id", "skill", "skillVersion", "promptVersion", "createdAt", "updatedAt", "input", "output", "provenance", "evaluation"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "artifactType": { "type": "string", "const": "adr" },
    "id": { "type": "string", "pattern": "^adr-.+$" },
    "skill": { "type": "string", "const": "docs-adrs" },
    "skillVersion": { "type": "string" },
    "promptVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "required": ["decisionContext"],
      "properties": {
        "decisionContext": { "type": "string" },
        "stakeholders": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "output": {
      "type": "object",
      "required": ["title", "status", "context", "decision", "consequences", "alternatives"],
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["proposed", "accepted", "deprecated", "superseded"] },
        "context": { "type": "string" },
        "decision": { "type": "string" },
        "consequences": {
          "type": "object",
          "required": ["positive", "negative", "neutral"],
          "properties": {
            "positive": { "type": "array", "items": { "type": "string" } },
            "negative": { "type": "array", "items": { "type": "string" } },
            "neutral": { "type": "array", "items": { "type": "string" } }
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "reasonRejected"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "reasonRejected": { "type": "string" }
            }
          }
        },
        "links": { "type": "array", "items": { "type": "string" } },
        "reviewDate": { "type": "string", "format": "date" },
        "supersededBy": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceOfTruth", "scope", "outOfScope", "nextConsumer"],
      "properties": {
        "sourceOfTruth": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } },
        "nextConsumer": { "type": "string", "enum": ["codebase-design", "api-design", "implement", "docs-management"] },
        "blockedBy": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "string" },
        "riskRemaining": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["qualityBarScore", "artifactPassedQualityBar", "evaluators"],
      "properties": {
        "qualityBarScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "artifactPassedQualityBar": { "type": "boolean" },
        "evaluators": {
          "type": "object",
          "required": ["behavioral", "traceability", "quality-bar"],
          "properties": {
            "behavioral": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } },
            "traceability": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } },
            "quality-bar": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } }
          }
        }
      }
    }
  }
}
