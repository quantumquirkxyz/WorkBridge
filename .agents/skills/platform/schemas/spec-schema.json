{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecArtifact",
  "description": "Durable spec artifact emitted by the to-spec skill. Typed, versioned, addressable.",
  "type": "object",
  "required": ["schemaVersion", "artifactType", "id", "skill", "skillVersion", "promptVersion", "createdAt", "updatedAt", "input", "output", "provenance", "evaluation"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "artifactType": { "type": "string", "const": "spec", "description": "Must be the literal string 'spec'." },
    "id": { "type": "string", "pattern": "^spec-.+$" },
    "skill": { "type": "string", "const": "to-spec" },
    "skillVersion": { "type": "string" },
    "promptVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "required": ["source", "domainGlossary"],
      "properties": {
        "source": { "type": "string", "description": "Conversation context, ADRs, issue references." },
        "domainGlossary": { "type": "array", "items": { "type": "string" } },
        "existingSpecs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "output": {
      "type": "object",
      "required": ["goals", "nonGoals", "acceptanceCriteria", "seams"],
      "properties": {
        "goals": { "type": "array", "items": { "type": "string" } },
        "nonGoals": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "seams": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "openQuestions": { "type": "array", "items": { "type": "string" } },
        "testingStrategy": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceOfTruth", "scope", "outOfScope", "nextConsumer"],
      "properties": {
        "sourceOfTruth": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } },
        "nextConsumer": { "type": "string", "enum": ["to-tickets", "grill-with-docs", "escalate"] },
        "blockedBy": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "string" },
        "riskRemaining": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["qualityBarScore", "artifactPassedQualityBar", "evaluators"],
      "properties": {
        "qualityBarScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "artifactPassedQualityBar": { "type": "boolean" },
        "evaluators": {
          "type": "object",
          "required": ["behavioral", "traceability", "quality-bar"],
          "properties": {
            "behavioral": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } },
            "traceability": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } },
            "quality-bar": { "type": "object", "required": ["passed", "score"], "properties": { "passed": { "type": "boolean" }, "score": { "type": "integer", "minimum": 0, "maximum": 100 }, "notes": { "type": "string" } } }
          }
        }
      }
    }
  }
}
