{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TicketArtifact",
  "description": "Durable ticket artifact emitted by the to-tickets skill. Typed, versioned, addressable.",
  "type": "object",
  "required": ["schemaVersion", "artifactType", "id", "skill", "skillVersion", "promptVersion", "createdAt", "updatedAt", "input", "output", "provenance", "evaluation"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "artifactType": { "type": "string", "const": "ticket" },
    "id": { "type": "string", "pattern": "^ticket-.+$" },
    "skill": { "type": "string", "const": "to-tickets" },
    "skillVersion": { "type": "string" },
    "promptVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "required": ["sourceRef"],
      "properties": {
        "sourceRef": { "type": "string" },
        "parentSpec": { "type": "string" },
        "verticalSliceRules": { "type": "boolean" }
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "acceptanceCriteria", "validation", "blockedBy"],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "description": { "type": "string" },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "validation": { "type": "string" },
          "blockedBy": { "type": "array", "items": { "type": "integer" } },
          "traceId": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "traceId": { "type": "string" },
        "sourceRef": { "type": "string" },
        "parentSpecId": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "completionCriteriaMet": { "type": "boolean" },
        "validatorNotes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
