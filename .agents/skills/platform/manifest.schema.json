{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quirk Skill Manifest",
  "description": "Frontmatter contract for a canonical SKILL.md. Required fields match the bundle's quality scorer; every field observed in the bundle's frontmatter vocabulary is accepted, including placeholder dialects (quoted scalars, empty strings, inline and block sequences).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "category"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "version": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
    "maturity": { "type": "string" },
    "capabilities": { "$ref": "#/$defs/stringList" },
    "inputs": { "$ref": "#/$defs/stringList" },
    "outputs": { "$ref": "#/$defs/mixedList" },
    "sideEffects": { "$ref": "#/$defs/stringList" },
    "dependencies": { "$ref": "#/$defs/stringList" },
    "stopCondition": { "type": "string" },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "trustTier": {
      "anyOf": [
        { "type": "string", "enum": ["", "1", "2", "3", "4"] },
        { "type": "number", "enum": [1, 2, 3, 4] }
      ]
    },
    "maxIterations": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
    "modelTier": { "type": "string" },
    "promptVersion": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
    "artifactType": { "type": "string" },
    "evaluators": { "$ref": "#/$defs/stringList" },
    "fixturesPath": { "type": "string" },
    "diataxis": { "type": "string" },
    "tags": { "$ref": "#/$defs/stringList" },
    "compatibility": { "$ref": "#/$defs/stringList" },
    "approvalRequired": { "anyOf": [{ "type": "string" }, { "type": "boolean" }] },
    "approvalFor": { "$ref": "#/$defs/stringList" },
    "disable-model-invocation": { "anyOf": [{ "type": "string" }, { "type": "boolean" }] },
    "clauses": { "$ref": "#/$defs/mixedList" },
    "reloadPolicy": { "anyOf": [{ "type": "string" }, { "type": "object" }] }
  },
  "$defs": {
    "stringList": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "anyOf": [{ "type": "string" }, { "type": "object" }] }
        }
      ]
    },
    "mixedList": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "anyOf": [{ "type": "string" }, { "type": "object" }] }
        }
      ]
    }
  }
}
